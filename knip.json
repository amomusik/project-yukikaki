{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": {
    "entry": [
      "next.config.ts",
      "middleware.ts",
      "app/**/{page,layout,not-found,error,loading,route,default,template}.{ts,tsx}",
      "app/**/actions.ts",
      "app/**/*-actions.ts",
      "i18n/request.ts"
    ]
  },
  "entry": ["scripts/*.ts", "evals/*.ts", "e2e/**/*.ts"],
  "project": ["**/*.{ts,tsx,mts}", "!.next/**", "!node_modules/**"],
  "ignoreDependencies": ["eslint-config-next", "tailwindcss"],
  "vitest": { "config": ["vitest.config.mts"], "entry": ["tests/**/*.test.ts", "tests/setup.ts"] },
  "playwright": { "config": ["playwright.config.ts"], "entry": ["e2e/**/*.spec.ts", "e2e/global-setup.ts"] }
}
