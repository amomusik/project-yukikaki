# Project Yukikaki — copy to .env.local and fill in what you have.
# Only Clerk and a database are "hard" dependencies. Every other service is optional:
# when its key is missing the app switches that service to a documented fallback
# (see docs/architecture.md → "Fallbacks"). Run `pnpm check:services` to see status.

# ── App ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Comma-separated emails that become town hosts (admins) on first sign-in.
HOST_EMAILS=you@example.com
# Random 32+ char string. Used to sign one-time impact-check links. `openssl rand -hex 32`
FEEDBACK_TOKEN_SECRET=

# Live-only mode: never fall back to pre-baked data; check:services fails unless every service is live.
REQUIRE_LIVE_SERVICES=false

# Days to keep interview / impact-review transcripts after a brief is approved or delivered.
# `pnpm retention` (run daily) clears older ones; `pnpm retention --dry-run` only lists them.
TRANSCRIPT_RETENTION_DAYS=90

# ── Auth: Clerk  https://dashboard.clerk.com ──────────────────────────
# Insert your own keys: Yukikaki does not use Clerk keyless dev mode. Both are needed for sign-in;
# if either is empty, sign-in is off and only the public pages work (protected pages explain setup).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Records: Neon Postgres  https://console.neon.tech ─────────────────
# Leave empty locally to use an embedded PGlite database stored in ./.data/pglite
DATABASE_URL=

# ── Challenge graph: Neo4j Aura  https://console.neo4j.io ─────────────
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── Challenge interview: ElevenLabs Agents  https://elevenlabs.io/app/agents
# Agent setup (prompts + data collection fields): docs/elevenlabs-agents.md
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEW_AGENT_ID=
ELEVENLABS_IMPACT_AGENT_ID=
# Only needed in production (post-call webhook). Local dev uses polling instead.
ELEVENLABS_WEBHOOK_SECRET=

# ── Data & context search: Linkup  https://app.linkup.so ──────────────
LINKUP_API_KEY=

# ── Approval workflow: Dify  https://cloud.dify.ai ────────────────────
# Import dify/brief-review.yml and dify/team-review.yml, then copy each app's API key.
DIFY_API_URL=https://api.dify.ai
DIFY_BRIEF_REVIEW_KEY=
DIFY_TEAM_REVIEW_KEY=

# ── Stand-in data: Adaption Labs  https://adaptionlabs.ai ─────────────
ADAPTION_API_KEY=
# Override if your account uses a different API host.
ADAPTION_API_URL=https://api.prod.adaptionlabs.ai

# ── Email: Resend  https://resend.com ────────────────────────────────
# Without a key (or a verified domain) impact links are shown in /admin with a Copy button.
RESEND_API_KEY=
EMAIL_FROM="Yukikaki <noreply@example.com>"
